# Project Settings
PROJECT_NAME="AI Portfolio Platform"
ENVIRONMENT=development

# CORS Configuration (comma-separated origins; no wildcard allowed in production)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin Access Allowlist (comma-separated emails authorized for write operations)
ADMIN_EMAILS=harishkamireddi@zohomail.in

# Supabase — get from https://supabase.com/dashboard/project/<your-ref>/settings/api
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-service-role-key>

# Optional Supabase JWT Secret for direct cryptographic token verification
# Found in Supabase Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=

# Gemini API — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<your-gemini-api-key>
